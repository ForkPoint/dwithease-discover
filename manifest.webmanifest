{
  "$schema": "https://json.schemastore.org/web-manifest-combined.json",
  "name": "DWithEase Discover",
  "short_name": "Discover",
  "description": "Commerce news, technical articles, and useful tools for teams that build online stores.",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "background_color": "#090d14",
  "theme_color": "#0879aa",
  "orientation": "any",
  "icons": [
    {
      "src": "assets/dwithease-logo.svg",
      "sizes": "192x192",
      "type": "image/svg+xml",
      "purpose": "any"
    },
    {
      "src": "assets/dwithease-logo.svg",
      "sizes": "512x512",
      "type": "image/svg+xml",
      "purpose": "any"
    },
    {
      "src": "assets/dwithease-logo.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "maskable"
    },
    {
      "src": "assets/discover-fallback.png",
      "sizes": "1200x630",
      "type": "image/png",
      "purpose": "any"
    }
  ],
  "categories": ["news", "business", "developer tools"]
}
