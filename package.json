{
  "name": "dwithease-discover",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "node --test test/*.test.js test/*.test.ts",
    "typecheck": "tsc --noEmit",
    "validate:feed": "node scripts/validate-feed.ts",
    "validate:sources": "node scripts/validate-sources.js",
    "harvest:salesforce-ideas": "node scripts/harvest-salesforce-ideas.js",
